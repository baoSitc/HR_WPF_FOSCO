<UserControl x:Class="HR_WPF_FOSCO.Views.NhanSuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>

            <!-- SEARCH -->
            <RowDefinition Height="130"/>

            <!-- GRID -->
            <RowDefinition Height="250"/>

            <!-- DETAIL -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- SEARCH -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="0"
                  Margin="10"
                  Header="Tìm kiếm nhân sự">

            <Grid Margin="0,10,0,-25">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="0.7*"/>

                    <ColumnDefinition Width="0.7*"/>

                    <ColumnDefinition Width="300"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- TRẠNG THÁI -->

                <ComboBox Grid.Column="0"
                          Margin="5"
                          Height="35"

                          Style="{StaticResource MaterialDesignComboBox}"

                          ItemsSource="{Binding TrangThaiList}"

                          SelectedItem="{Binding TrangThaiFilter,
                          Mode=TwoWay}"/>

                <!-- SEARCH -->

                <DockPanel Grid.Column="1"
                           Margin="5">

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="24"
                                             Height="24"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                    <TextBox Height="35"
                             FontSize="14"

                             VerticalContentAlignment="Center"

                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"

                             Text="{Binding TuKhoa,
                             Mode=TwoWay,
                             UpdateSourceTrigger=PropertyChanged}"

                             materialDesign:HintAssist.Hint="Tìm mã, tên nhân viên..."/>

                </DockPanel>

                <!-- ĐƠN VỊ -->

                <ComboBox Grid.Column="2"
                          Margin="5"
                          Height="35"

                          Style="{StaticResource MaterialDesignComboBox}"

                          ItemsSource="{Binding DonVis}"

                          SelectedValuePath="ID_DonVi"

                          SelectedValue="{Binding SelectedDonViID,
                          Mode=TwoWay}"

                          IsEditable="True"

                          IsTextSearchEnabled="True"

                          DisplayMemberPath="TenHienThi"

                          TextSearch.TextPath="TenHienThi"

                          materialDesign:HintAssist.Hint="Chọn đơn vị..."/>

                <!-- BUTTON -->

                <Button Grid.Column="3"
                        Margin="5"
                        Height="35"
                        Content="Thêm nhân sự"/>

            </Grid>

        </GroupBox>

        <!-- ================================================= -->
        <!-- GRID -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="1"
                  Margin="10"
                  Header="Danh sách nhân sự">

            <DataGrid Margin="5"

                      AutoGenerateColumns="False"

                      ItemsSource="{Binding NhanSus}"

                      SelectedItem="{Binding SelectedNhanSu,
                      Mode=TwoWay}"

                      FrozenColumnCount="2"

                      EnableRowVirtualization="True"

                      EnableColumnVirtualization="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="STT"
                                        Binding="{Binding Stt}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Mã NV"
                                        Binding="{Binding MaNhanSu}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Họ tên"
                                        Binding="{Binding HoTen}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Đơn vị"
                                        Binding="{Binding DonVi.TenDonVi}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Chức vụ"
                                        Binding="{Binding ChucDanh}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Điện thoại"
                                        Binding="{Binding DienThoaiDiDong}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Số CCCD"
                                        Binding="{Binding CCCD}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding TrangThaiLamViec}"
                                        Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- ================================================= -->
        <!-- DETAIL -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="2"
                  Margin="10"
                  Header="Thông tin nhân sự">

            <Grid>

                <TabControl Margin="5">

                    <!-- ====================================== -->
                    <!-- TAB SƠ YẾU -->
                    <!-- ====================================== -->

                    <TabItem Header="Sơ yếu">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <Grid Margin="15">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>

                                </Grid.RowDefinitions>

                                <!-- MÃ NV -->

                                <TextBlock Text="Mã nhân sự:"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Column="1"

                                         Text="{Binding SelectedNhanSu.MaNhanSu,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- HỌ TÊN -->

                                <TextBlock Grid.Column="2"
                                           Text="Họ tên:"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Column="3"

                                         Text="{Binding SelectedNhanSu.HoTen,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- NGÀY SINH -->

                                <TextBlock Grid.Row="1"
                                           Text="Ngày sinh:"
                                           VerticalAlignment="Center"/>

                                <DatePicker Grid.Row="1"
                                            Grid.Column="1"

                                            SelectedDate="{Binding SelectedNhanSu.NgaySinh,
                                            Mode=TwoWay}"/>

                                <!-- GIỚI TÍNH -->

                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="Giới tính:"
                                           VerticalAlignment="Center"/>

                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"

                                          ItemsSource="{Binding GenderList}"

                                          SelectedItem="{Binding GioiTinhText,
                                          Mode=TwoWay}"/>

                                <!-- CCCD -->

                                <TextBlock Grid.Row="2"
                                           Text="CCCD:"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"

                                         Text="{Binding SelectedNhanSu.CCCD,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- MST -->

                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="MST:"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Row="2"
                                         Grid.Column="3"

                                         Text="{Binding SelectedNhanSu.MaSoThueCaNhan,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Nơi Sinh-->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Nơi sinh:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNhanSu.NoiSinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Trạng thái -->
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Trạng thái làm việc:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="3" Grid.Column="3" 
                                          ItemsSource="{Binding TrangThaiList}"
                                    SelectedItem="{Binding TrangThaiLamViec, Mode=TwoWay}"/>
                            </Grid>

                        </ScrollViewer>

                    </TabItem>

                    <!-- TAB LIÊN HỆ -->

                    <TabItem Header="Liên hệ"/>

                    <!-- TAB LƯƠNG -->

                    <TabItem Header="Lương - BHXH"/>

                    <!-- TAB NPT -->

                    <TabItem Header="Người phụ thuộc"/>

                    <!-- TAB LỊCH SỬ LƯƠNG -->

                    <TabItem Header="Lịch sử lương"/>

                    <!-- TAB PHỤ CẤP -->

                    <TabItem Header="Phụ cấp"/>

                </TabControl>

            </Grid>

        </GroupBox>

    </Grid>

</UserControl>