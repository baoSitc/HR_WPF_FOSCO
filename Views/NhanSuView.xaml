<UserControl x:Class="HR_WPF_FOSCO.Views.NhanSuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>

            <!-- SEARCH -->
            <RowDefinition Height="130"/>

            <!-- GRID -->
            <RowDefinition Height="250"/>

            <!-- DETAIL -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- SEARCH -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="0"
                  Margin="10"
                  Header="Tìm kiếm nhân sự">

            <Grid Margin="0,10,0,-25">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="0.7*"/>

                    <ColumnDefinition Width="0.7*"/>

                    <ColumnDefinition Width="300"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- TRẠNG THÁI -->

                <ComboBox Grid.Column="0"
                          Margin="5"
                          Height="35"

                          Style="{StaticResource MaterialDesignComboBox}"

                          ItemsSource="{Binding TrangThaiList}"

                          SelectedItem="{Binding TrangThaiFilter,
                          Mode=TwoWay}"/>

                <!-- SEARCH -->

                <DockPanel Grid.Column="1"
                           Margin="5">

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="24"
                                             Height="24"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                    <TextBox Height="35"
                             FontSize="14"

                             VerticalContentAlignment="Center"

                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"

                             Text="{Binding TuKhoa,
                             Mode=TwoWay,
                             UpdateSourceTrigger=PropertyChanged}"

                             materialDesign:HintAssist.Hint="Tìm mã, tên nhân viên..."/>

                </DockPanel>

                <!-- ĐƠN VỊ -->

                <ComboBox Grid.Column="2"
                          Margin="5"
                          Height="35"

                          Style="{StaticResource MaterialDesignComboBox}"

                          ItemsSource="{Binding DonVis}"

                          SelectedValuePath="ID_DonVi"

                          SelectedValue="{Binding SelectedDonViID,
                          Mode=TwoWay}"

                          IsEditable="True"

                          IsTextSearchEnabled="True"

                          DisplayMemberPath="TenHienThi"

                          TextSearch.TextPath="TenHienThi"

                          materialDesign:HintAssist.Hint="Chọn đơn vị..."/>

                <!-- BUTTON -->
                <StackPanel Grid.Column="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="5">

                    <!-- THÊM -->

                    <Button Height="38"
            Margin="5"
            Padding="15,0"
            Background="#4CAF50"
            Foreground="White"
            Style="{StaticResource MaterialDesignRaisedButton}">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="PlusBold"
                                     Width="18"
                                     Height="18"
                                     Margin="0,0,5,0"/>

                            <TextBlock Text="Thêm"/>

                        </StackPanel>

                    </Button>

                    <!-- Sửa -->

                    <Button Height="38"
            Margin="5"
            Padding="15,0"
            Background="#2196F3"
            Foreground="White"
            Style="{StaticResource MaterialDesignRaisedButton}">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="ContentSave"
                                     Width="18"
                                     Height="18"
                                     Margin="0,0,5,0"/>

                            <TextBlock Text="Sửa"/>

                        </StackPanel>

                    </Button>

                    <!-- XÓA -->

                    <Button Height="38"
            Margin="5"
            Padding="15,0"
            Background="#F44336"
            Foreground="White"
            Style="{StaticResource MaterialDesignRaisedButton}">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Delete"
                                     Width="18"
                                     Height="18"
                                     Margin="0,0,5,0"/>

                            <TextBlock Text="Xóa"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </GroupBox>

        <!-- ================================================= -->
        <!-- GRID -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="1"
                  Margin="10"
                  Header="Danh sách nhân sự">

            <DataGrid Margin="5"

                      AutoGenerateColumns="False"

                      ItemsSource="{Binding NhanSus}"

                      SelectedItem="{Binding SelectedNhanSu,
                      Mode=TwoWay}"

                      FrozenColumnCount="2"

                      EnableRowVirtualization="True"

                      EnableColumnVirtualization="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="STT"
                                        Binding="{Binding Stt}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Mã NV"
                                        Binding="{Binding MaNhanSu}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Họ tên"
                                        Binding="{Binding HoTen}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Đơn vị"
                                        Binding="{Binding DonVi.TenDonVi}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Chức vụ"
                                        Binding="{Binding ChucDanh}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Điện thoại"
                                        Binding="{Binding DienThoaiDiDong}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Số CCCD"
                                        Binding="{Binding CCCD}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding TrangThaiLamViec}"
                                        Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- ================================================= -->
        <!-- DETAIL -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="2"
                  Margin="10"
                  Header="Thông tin nhân sự">

            <Grid>

                <TabControl Margin="5">

                    <!-- ====================================== -->
                    <!-- TAB SƠ YẾU -->
                    <!-- ====================================== -->

                    <TabItem Header="Sơ yếu">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <Grid Margin="15">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>

                                </Grid.RowDefinitions>

                                <!-- MÃ NV -->
                                <DockPanel Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Account"
                                                          Width="20"
                                                          Height="20"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Mã nhân sự:"
                                        VerticalAlignment="Center"/>
                                </DockPanel>                             

                                <TextBox Grid.Column="1"

                                         Text="{Binding SelectedNhanSu.MaNhanSu,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- HỌ TÊN -->
                                <DockPanel Grid.Column="2">
                                    <materialDesign:PackIcon Kind="Account"
                                                          Width="20"
                                                          Height="20"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Họ tên:"
                                        VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBox Grid.Column="3"
                                         Text="{Binding SelectedNhanSu.HoTen,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- NGÀY SINH -->
                                <DockPanel Grid.Row="1">
                                    <materialDesign:PackIcon Kind="Calendar"
                                                          Width="20"
                                                          Height="20"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1"
                                           Text="Ngày sinh:"
                                           VerticalAlignment="Center"/>
                                </DockPanel>

                                <DatePicker Grid.Row="1"
                                            Grid.Column="1"

                                            SelectedDate="{Binding SelectedNhanSu.NgaySinh,
                                            Mode=TwoWay}"/>

                                <!-- GIỚI TÍNH -->
                                <DockPanel Grid.Row="1" Grid.Column="2">
                                    <materialDesign:PackIcon Kind="GenderMaleFemale"
                                                          Width="20"
                                                          Height="20"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="Giới tính:"
                                           VerticalAlignment="Center"/>
                                </DockPanel>

                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"

                                          ItemsSource="{Binding GenderList}"

                                          SelectedItem="{Binding GioiTinhText,
                                          Mode=TwoWay}"/>

                                <!-- CCCD -->
                                <DockPanel Grid.Row="2">
                                    <materialDesign:PackIcon Kind="CardAccountDetails"
                                                          Width="20"
                                                          Height="20"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2"
                                           Text="CCCD:"
                                           VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"

                                         Text="{Binding SelectedNhanSu.CCCD,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- MST -->
                                <DockPanel Grid.Row="2" Grid.Column="2">
                                    <materialDesign:PackIcon Kind="CardAccountDetails"
                                                          Width="20"
                                                          Height="20"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="MST:"
                                           VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBox Grid.Row="2"
                                         Grid.Column="3"

                                         Text="{Binding SelectedNhanSu.MaSoThueCaNhan,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Nơi Sinh-->
                                <DockPanel Grid.Row="3">
                                    <materialDesign:PackIcon Kind="MapMarker"
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Nơi sinh:" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNhanSu.NoiSinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Trạng thái -->
                                <DockPanel Grid.Row="3" Grid.Column="2">
                                    <materialDesign:PackIcon Kind="Information"
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Trạng thái làm việc:" VerticalAlignment="Center"/>
                                </DockPanel>
                                
                                <ComboBox Grid.Row="3" Grid.Column="3" 
                                         
                                    SelectedValue="{Binding SelectedNhanSu.TrangThaiLamViec, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Content">
                                    <ComboBoxItem Content="Đang làm việc"/>
                                    <ComboBoxItem Content="Đã nghỉ việc"/>
                                    <ComboBoxItem Content="Không xác định"/>
                                </ComboBox>
                                
                                <!--Trình độ  -->
                                <DockPanel Grid.Row="4">
                                    <materialDesign:PackIcon Kind="School"
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Trình độ học vấn:" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ComboBox Grid.Row="4" Grid.Column="1" 
          
     SelectedValue="{Binding SelectedNhanSu.TrinhDoHocVan, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
     SelectedValuePath="Content">
                                    <ComboBoxItem Content="Trung học phổ thông"/>
                                    <ComboBoxItem Content="Trung học cơ  sở"/>
                                    <ComboBoxItem Content="Sơ cấp"/>
                                    <ComboBoxItem Content="Trung cấp"/>
                                    <ComboBoxItem Content="Cao đẳng"/>
                                    <ComboBoxItem Content="Đại học"/>
                                    <ComboBoxItem Content="Thạc sĩ"/>
                                    <ComboBoxItem Content="Tiến sĩ"/>
                                </ComboBox>
                                <!--Chức danh hiện tại-->
                                <DockPanel Grid.Row="4" Grid.Column="2">
                                    <materialDesign:PackIcon Kind="Briefcase"
                                                            Width="20"
                                                            Height="20"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Chức danh hiện tại:" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding SelectedNhanSu.ChucDanhHienTai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                
                            </Grid>

                        </ScrollViewer>

                    </TabItem>

                    <!-- TAB LIÊN HỆ -->

                    <TabItem Header="Liên hệ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <Grid Margin="15">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>

                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>

                                </Grid.RowDefinitions>
                                <!-- ĐIỆN THOẠI DI ĐỘNG -->
                                <DockPanel Grid.Column="0" Grid.Row="0">
                                    <materialDesign:PackIcon Kind="Cellphone"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Điện thoại di động:"
                                           VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox Grid.Column="1" Text="{Binding SelectedNhanSu.DienThoaiDiDong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- ĐIỆN THOẠI Cơ Quan -->
                                <DockPanel Grid.Column="2" Grid.Row="0">
                                    <materialDesign:PackIcon Kind="PhoneClassic"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                                    
                                    <TextBlock Text="Điện thoại cơ quan:" Grid.Column="2"
       VerticalAlignment="Center"/>
                                </DockPanel>
                                
                                <TextBox Grid.Column="3" Text="{Binding SelectedNhanSu.DienThoaiCoQuan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Email -->
                                <DockPanel Grid.Column="0" Grid.Row="1">
                                    <materialDesign:PackIcon Kind="Email"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Email cá nhân:" Grid.Column="0" Grid.Row="1"
        VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding SelectedNhanSu.EmailCaNhan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Email Cơ Quan-->
                                <DockPanel Grid.Column="2" Grid.Row="1">
                                    <materialDesign:PackIcon Kind="Email"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Email cơ quan:" Grid.Column="2" Grid.Row="1"
                                                VerticalAlignment="Center"/>                                    

                                </DockPanel>
                                <TextBox Grid.Column="3" Grid.Row="1" Text="{Binding SelectedNhanSu.EmailCoQuan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                               

                                <!-- Chỗ ở hiện nay -->
                                <DockPanel Grid.Column="0" Grid.Row="2">
                                    <materialDesign:PackIcon Kind="Home"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Chỗ ở hiện nay:" Grid.Column="0" Grid.Row="2"
                                       VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding SelectedNhanSu.ChoOHienNay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <!--Số tài khoản-->
                                <DockPanel Grid.Column="2" Grid.Row="2">
                                    <materialDesign:PackIcon Kind="Bank"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Số tài khoản:" Grid.Column="2" Grid.Row="2"
                                                VerticalAlignment="Center"/>                                    

                                </DockPanel>
                                <TextBox Grid.Column="3" Grid.Row="2" Text="{Binding SelectedNhanSu.SoTaiKhoanNganHang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <!--Ngân Hàng-->
                                <DockPanel Grid.Column="0" Grid.Row="3">
                                    <materialDesign:PackIcon Kind="Bank"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Ngân hàng:" Grid.Column="0" Grid.Row="3"
                                                VerticalAlignment="Center"/>                                    

                                </DockPanel>
                                <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding SelectedNhanSu.NganHang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <!--Chi nhánh-->
                                <DockPanel Grid.Column="2" Grid.Row="3">
                                    <materialDesign:PackIcon Kind="BankCircle"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Chi nhánh:" Grid.Column="2" Grid.Row="3"
                                                VerticalAlignment="Center"/>                                    

                                </DockPanel>
                                <TextBox Grid.Column="3" Grid.Row="3" Text="{Binding SelectedNhanSu.ChiNhanhNganHang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            </Grid>
                        </ScrollViewer>
                    </TabItem>


                    <!-- TAB LƯƠNG -->

                    <TabItem Header="Lương - BHXH"/>

                    <!-- TAB NPT -->

                    <TabItem Header="Người phụ thuộc"/>

                    <!-- TAB LỊCH SỬ LƯƠNG -->

                    <TabItem Header="Lịch sử lương">
                        <Grid>
                            <!-- Chia grid thành 2 dòng, 1 dòng cho toolbar, 1 dòng cho nội dung -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!--Phần form-->
                                <Border Background="White" Grid.Column="0"
CornerRadius="8"
Padding="10"
Margin="5"
BorderBrush="ForestGreen"
BorderThickness="1">

                                    <WrapPanel>

                                        <!-- TỪ NGÀY -->

                                        <StackPanel Width="180"
            Margin="5">

                                           
                                            <DatePicker Height="50"  Margin="0,5,0,0"
                                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                          materialDesign:HintAssist.Hint="Từ ngày"                                                
                                        SelectedDate="{Binding SelectedQuaTrinhLuong.TuNgay, StringFormat={}{dd/MM/yyyy}, 
                                                Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>


                                        </StackPanel>

                                        <!-- ĐẾN NGÀY -->

                                        <StackPanel Width="180"    Margin="5">                                     

                                            <DatePicker Height="50"  Margin="0,5,0,0"
                                      Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                         materialDesign:HintAssist.Hint="Đến ngày"            
                                                        SelectedDateFormat="Short"
                                         SelectedDate="{Binding SelectedQuaTrinhLuong.DenNgay,
                                             Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <!-- TIỀN TỆ -->

                                        <StackPanel Width="100"   Margin="5">

                                            

                                            <ComboBox Height="50"  Margin="0,5,0,0"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                       materialDesign:HintAssist.Hint="Tiền tệ"
  
                            SelectedValue="{Binding SelectedQuaTrinhLuong.TienTe, 
                                Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Content">
                                                <ComboBoxItem Content="U"/>
                                                <ComboBoxItem Content="D"/>
                                            </ComboBox>

                                        </StackPanel>

                                        <!-- LƯƠNG -->

                                        <StackPanel Width="150"  Margin="5">                                         

                                            <TextBox Height="50"  Margin="0,5,0,0"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Lương thực tế"
                                     Text="{Binding SelectedQuaTrinhLuong.LuongThucTe,StringFormat={}{0:N2},
                                        Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                        </StackPanel>
                                        <!-- LƯƠNG HỢP ĐỒNG -->
                                        <StackPanel Width="150" Margin="5">                                           

                                            <TextBox Height="50"  Margin="0,5,0,0"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Lương hợp đồng"
                                     Text="{Binding SelectedQuaTrinhLuong.LuongDongBHXH,StringFormat={}{0:N2},
                                        Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                        </StackPanel>

                                        <StackPanel Width="250" Margin="5">                                          

                                            <TextBox Height="50"  Margin="0,5,0,0"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Ghi chú"
                                     Text="{Binding SelectedQuaTrinhLuong.GhiChu,
                                        Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                        </StackPanel>
                                        <StackPanel Width="120" Margin="5">
                                            <CheckBox Content="Đang sử dụng"

          Margin="5"

          FontWeight="SemiBold"

          Foreground="#1976D2"

          Style="{StaticResource MaterialDesignCheckBox}"

          IsChecked="{Binding SelectedQuaTrinhLuong.DangSuDung,
          Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>



                                    </WrapPanel>

                                </Border>
                                <!--Phần Menu-->
                                <Border Background="White" Grid.Column="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="5"
                                    BorderBrush="ForestGreen"
                                    BorderThickness="1">

                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>                                          
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- THÊM -->

                                        <Button Width="100" Grid.Column="0" Grid.Row="0"
                                            Margin="5"
                                            Background="#4CAF50"
                                            Foreground="White"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Click="BtnAddLuong_Click">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="Plus"
                         Width="18"
                         Height="18"
                         Margin="0,0,5,0"/>

                                                <TextBlock Text="Thêm"/>

                                            </StackPanel>

                                        </Button>

                                        <!-- XÓA -->

                                        <Button Width="100"  Grid.Column="1" Grid.Row="0"
                                        Margin="5"
                                        Background="#F44336"
                                        Foreground="White"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="BtnDeleteLuong_Click">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="Delete"
                         Width="18"
                         Height="18"
                         Margin="0,0,5,0"/>

                                                <TextBlock Text="Xóa"/>

                                            </StackPanel>

                                        </Button>

                                        <!-- LƯU -->

                                        <Button Width="100"  Grid.Column="0" Grid.Row="1"
                                        Margin="5"
                                        Background="#2196F3"
                                        Foreground="White"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="BtnSaveLuong_Click">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="ContentSave"
                         Width="18"
                         Height="18"
                         Margin="0,0,5,0"/>

                                                <TextBlock Text="Lưu"/>

                                            </StackPanel>

                                        </Button>
                                        <!--Import-->
                                        <Button Width="100"  Grid.Column="1" Grid.Row="1"
          Margin="5"
          Background="#FF9800"
          Foreground="White"
          Style="{StaticResource MaterialDesignRaisedButton}"
          Click="BtnImportLuong_Click">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="Import"
   Width="18"
   Height="18"
   Margin="0,0,5,0"/>

                                                <TextBlock Text="Import"/>

                                            </StackPanel>

                                        </Button>

                                    </Grid>
                                </Border>

                            </Grid>
                                
                         
                            
                            <!--tẠO GRID QUÁ TRÌNH LƯƠNG-->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding QuaTrinhLuongs}"
                                      SelectedItem="{Binding SelectedQuaTrinhLuong, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay,StringFormat=dd/MM/yyyy}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay,StringFormat=dd/MM/yyyy}" />
                                    <DataGridTextColumn Header="Tiền tệ" Binding="{Binding TienTe}" />
                                    <DataGridTextColumn Header="Lương thực tế" Binding="{Binding LuongThucTe,StringFormat=N2}" />
                                    
                                    <DataGridTextColumn Header="Lương Hợp đồng" Binding="{Binding LuongDongBHXH,StringFormat=N2}" />
                                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding GhiChu}" />
                                    <DataGridCheckBoxColumn Header="Đang sử dụng" Binding="{Binding DangSuDung}" />

                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>
                    </TabItem>


                    <!-- TAB PHỤ CẤP -->

                    <TabItem Header="Phụ Cấp">
                        <Grid>
                            <!-- Chia grid thành 2 dòng, 1 dòng cho toolbar, 1 dòng cho nội dung -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!--Phần form-->
                                <Border Background="White" Grid.Column="0"
                    CornerRadius="8"
                    Padding="10"
                    Margin="5"
                    BorderBrush="ForestGreen"
                    BorderThickness="1">

                                    <WrapPanel>

                                        <!-- TỪ NGÀY -->

                                        <StackPanel Width="180"
            Margin="5">


                                            <DatePicker Height="50"  Margin="0,5,0,0"
                                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                          materialDesign:HintAssist.Hint="Từ ngày"                                                
                                        SelectedDate="{Binding SelectedQuaTrinhPhuCap.HieuLucTuNgay, StringFormat={}{dd/MM/yyyy}, 
                                                Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>


                                        </StackPanel>

                                        <!-- ĐẾN NGÀY -->

                                        <StackPanel Width="180"    Margin="5">

                                            <DatePicker Height="50"  Margin="0,5,0,0"
                                      Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                         materialDesign:HintAssist.Hint="Đến ngày"            
                                                        SelectedDateFormat="Short"
                                         SelectedDate="{Binding SelectedQuaTrinhPhuCap.HieuLucDenNgay,
                                             Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <!-- TIỀN TỆ -->

                                        <StackPanel Width="100"   Margin="5">



                                            <ComboBox Height="50"  Margin="0,5,0,0"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                       materialDesign:HintAssist.Hint="Tiền tệ"
  
                            SelectedValue="{Binding SelectedQuaTrinhPhuCap.TienTe, 
                                Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Content">
                                                <ComboBoxItem Content="U"/>
                                                <ComboBoxItem Content="D"/>
                                            </ComboBox>

                                        </StackPanel>

                                        <!-- Tiền Phụ Cấp -->

                                        <StackPanel Width="150"  Margin="5">

                                            <TextBox Height="50"  Margin="0,5,0,0"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Tiền phụ cấp"
                                     Text="{Binding SelectedQuaTrinhPhuCap.TienPhuCap,StringFormat={}{0:N2},
                                        Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                        </StackPanel>
                                        <!-- Tiền Ăn Uống -->
                                        <StackPanel Width="150" Margin="5">

                                            <TextBox Height="50"  Margin="0,5,0,0"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Tiền ăn"
                                     Text="{Binding SelectedQuaTrinhPhuCap.TienAn,StringFormat={}{0:N2},
                                        Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>                                           

                                        </StackPanel>
                                        <!-- Tiền Điện thoại -->
                                        <StackPanel Width="150" Margin="5">

                                            <TextBox Height="50"  Margin="0,5,0,0"
Style="{StaticResource MaterialDesignOutlinedTextBox}"
  materialDesign:HintAssist.Hint="Tiền điện thoại"
  Text="{Binding SelectedQuaTrinhPhuCap.TienDienThoai,StringFormat={}{0:N2},
     Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                        </StackPanel>
                                        <!-- Tiền Công Tác -->
                                        <StackPanel Width="150" Margin="5">

                                            <TextBox Height="50"  Margin="0,5,0,0"
Style="{StaticResource MaterialDesignOutlinedTextBox}"
  materialDesign:HintAssist.Hint="Tiền công tác"
  Text="{Binding SelectedQuaTrinhPhuCap.TienCongTac,StringFormat={}{0:N2},
     Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <!-- Tiền Trang Phục -->
                                        <StackPanel Width="150" Margin="5">
                                            <TextBox Height="50"  Margin="0,5,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                          materialDesign:HintAssist.Hint="Tiền trang phục"
                                          Text="{Binding SelectedQuaTrinhPhuCap.TienTrangPhuc,StringFormat={}{0:N2},
                                             Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <!-- Tiền Khác Có Thuế -->

                                        <StackPanel Width="250" Margin="5">
                                            <TextBox Height="50"  Margin="0,5,0,0"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Khác có thuế"
                                     Text="{Binding SelectedQuaTrinhPhuCap.TienKhac_Thue,StringFormat={}{0:N2},
                                    Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <!-- Tiền Khác Không Có Thuế -->

                                        <StackPanel Width="250" Margin="5">
                                            <TextBox Height="50"  Margin="0,5,0,0"
Style="{StaticResource MaterialDesignOutlinedTextBox}"
  materialDesign:HintAssist.Hint="Khác không có thuế"
  Text="{Binding SelectedQuaTrinhPhuCap.TienKhac_KhongThue,StringFormat={}{0:N2},
 Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>


                                        <StackPanel Width="250" Margin="5">
                                            <TextBox Height="50"  Margin="0,5,0,0"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Ghi chú"
                                     Text="{Binding SelectedQuaTrinhPhuCap.GhiChu,
                                        Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                        </StackPanel>
                                        <StackPanel Width="120" Margin="5">
                                            <CheckBox Content="Đang sử dụng"

                                              Margin="5"

                                              FontWeight="SemiBold"

                                              Foreground="#1976D2"

                                              Style="{StaticResource MaterialDesignCheckBox}"

                                              IsChecked="{Binding SelectedQuaTrinhPhuCap.DangSuDung,
                                              Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>   
                                        </StackPanel>



                                    </WrapPanel>

                                </Border>
                                <!--Phần Menu-->
                                <Border Background="White" Grid.Column="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="5"
                                    BorderBrush="ForestGreen"
                                    BorderThickness="1">

                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- THÊM -->

                                        <Button Width="100" Grid.Column="0" Grid.Row="0"
                                            Margin="5"
                                            Background="#4CAF50"
                                            Foreground="White"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Click="BtnAddPhuCap_Click">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="Plus"
                         Width="18"
                         Height="18"
                         Margin="0,0,5,0"/>

                                                <TextBlock Text="Thêm"/>

                                            </StackPanel>

                                        </Button>

                                        <!-- XÓA -->

                                        <Button Width="100"  Grid.Column="1" Grid.Row="0"
                                        Margin="5"
                                        Background="#F44336"
                                        Foreground="White"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="BtnDeletePhuCap_Click">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="Delete"
                         Width="18"
                         Height="18"
                         Margin="0,0,5,0"/>

                                                <TextBlock Text="Xóa"/>

                                            </StackPanel>

                                        </Button>

                                        <!-- LƯU -->

                                        <Button Width="100"  Grid.Column="0" Grid.Row="1"
                                        Margin="5"
                                        Background="#2196F3"
                                        Foreground="White"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="BtnSavePhuCap_Click">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="ContentSave"
                         Width="18"
                         Height="18"
                         Margin="0,0,5,0"/>

                                                <TextBlock Text="Lưu"/>

                                            </StackPanel>

                                        </Button>
                                        <!--Import-->
                                        <Button Width="100"  Grid.Column="1" Grid.Row="1"
          Margin="5"
          Background="#FF9800"
          Foreground="White"
          Style="{StaticResource MaterialDesignRaisedButton}"
          Click="BtnImportPhuCap_Click">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="Import"
   Width="18"
   Height="18"
   Margin="0,0,5,0"/>

                                                <TextBlock Text="Import"/>

                                            </StackPanel>

                                        </Button>

                                    </Grid>
                                </Border>

                            </Grid>



                            <!--tẠO GRID QUÁ TRÌNH LƯƠNG-->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding QuaTrinhPhuCaps}"
                                      SelectedItem="{Binding SelectedQuaTrinhPhuCap, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Từ ngày" Binding="{Binding HieuLucTuNgay,StringFormat=dd/MM/yyyy}"/>
                                    <DataGridTextColumn Header="Đến ngày" Binding="{Binding HieuLucDenNgay,StringFormat=dd/MM/yyyy}" />
                                    <DataGridTextColumn Header="Tiền tệ" Binding="{Binding TienTe}" />
                                    <DataGridTextColumn Header="Phụ cấp" Binding="{Binding TienPhuCap,StringFormat=N2}" />

                                    <DataGridTextColumn Header="Tiền ăn" Binding="{Binding TienAn,StringFormat=N2}" />
                                    <DataGridTextColumn Header="Tiền điện thoại" Binding="{Binding TienDienThoai,StringFormat=N2}" />
                                    <DataGridTextColumn Header="Tiền công tác" Binding="{Binding TienCongTac,StringFormat=N2}" />
                                    <DataGridTextColumn Header="Tiền trang phục" Binding="{Binding TienTrangPhuc,StringFormat=N2}" />
                                    <DataGridTextColumn Header="Tiền khác" Binding="{Binding TienKhac_Thue,StringFormat=N2}" />
                                    <DataGridTextColumn Header="Tiền khác không thuế" Binding="{Binding TienKhac_KhongThue ,StringFormat=N2}" />
                                    <DataGridCheckBoxColumn Header="Đang sử dụng" Binding="{Binding DangSuDung}" />

                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>
                    </TabItem>

                </TabControl>

            </Grid>

        </GroupBox>

    </Grid>

</UserControl>