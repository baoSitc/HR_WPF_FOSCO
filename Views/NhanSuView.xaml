<UserControl x:Class="HR_WPF_FOSCO.Views.NhanSuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HR_WPF_FOSCO.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HR_WPF_FOSCO.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <vm:NhanSuViewModel x:Key="NhanSuViewModel"/>
    </UserControl.Resources>
    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>

            <!-- SEARCH -->
            <RowDefinition Height="130"/>

            <!-- GRID -->
            <RowDefinition Height="250"/>

            <!-- DETAIL -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- SEARCH -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="0"
                  Margin="10"
                  Header="Tìm kiếm nhân sự">

            <Grid Margin="0,10,0,-25">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="0.7*"/>

                    <ColumnDefinition Width="300"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- SEARCH -->

                <DockPanel Grid.Column="0"
                           Margin="5">

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="24"
                                             Height="24"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                    <TextBox Height="35"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Tìm mã, tên nhân viên..."/>

                </DockPanel>

                <!-- ĐƠN VỊ -->

                <ComboBox Grid.Column="1"
                          Margin="5"
                          Height="35"
                          Style="{StaticResource MaterialDesignComboBox}"
                          ItemsSource="{Binding DonVis, Source={StaticResource NhanSuViewModel}}"
                          DisplayMemberPath="TenDonVi"

                            SelectedValuePath="ID_DonVi" 
                        
                          SelectedValue="{Binding SelectedDonViID, Source={StaticResource NhanSuViewModel}}"
                          materialDesign:HintAssist.Hint="Chọn đơn vị..."/>

                <!-- BUTTON -->

                <Button Grid.Column="2"
                        Margin="5"
                        Height="35"
                        Content="Thêm nhân sự"/>

            </Grid>

        </GroupBox>

        <!-- ================================================= -->
        <!-- GRID -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="1"
                  Margin="10"
                  Header="Danh sách nhân sự">

            <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding NhanSus, Source={StaticResource NhanSuViewModel}}"
                      Margin="5"

                      FrozenColumnCount="2"

                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Mã NV"
                                        Binding="{Binding MaNhanSu}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Họ tên"
                                        Binding="{Binding HoTen}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Đơn vị"
                                        Binding="{Binding DonVi.TenDonVi}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Chức vụ"
                                        Binding="{Binding ChucDanh}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Điện thoại"
                                        Binding="{Binding DienThoai}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Số CCCD"
                       Binding="{Binding CCCD}"
                       Width="120"/>

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding TrangThai}"
                                        Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- ================================================= -->
        <!-- DETAIL -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="2"
                  Margin="10"
                  Header="Thông tin nhân sự">

            <Grid>

                <TabControl Margin="5">

                    <!-- ====================================== -->
                    <!-- TAB SƠ YẾU -->
                    <!-- ====================================== -->

                    <TabItem Header="Sơ yếu">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <Grid Margin="15">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>

                                </Grid.RowDefinitions>

                                <TextBlock Text="Mã nhân sự:"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Column="1"/>

                                <TextBlock Grid.Column="2"
                                           Text="Họ tên:"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Column="3"/>

                                <TextBlock Grid.Row="1"
                                           Text="Ngày sinh:"
                                           VerticalAlignment="Center"/>

                                <DatePicker Grid.Row="1"
                                            Grid.Column="1"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="Giới tính:"
                                           VerticalAlignment="Center"/>

                                <ComboBox Grid.Row="1"
                                          Grid.Column="3"/>

                                <TextBlock Grid.Row="2"
                                           Text="CCCD:"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="MST:"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Row="2"
                                         Grid.Column="3"/>

                            </Grid>

                        </ScrollViewer>

                    </TabItem>

                    <!-- ====================================== -->
                    <!-- TAB LIÊN HỆ -->
                    <!-- ====================================== -->

                    <TabItem Header="Liên hệ"/>

                    <!-- ====================================== -->
                    <!-- TAB BHXH -->
                    <!-- ====================================== -->

                    <TabItem Header="Lương - BHXH"/>

                    <!-- ====================================== -->
                    <!-- TAB NPT -->
                    <!-- ====================================== -->

                    <TabItem Header="Người phụ thuộc"/>

                    <!-- ====================================== -->
                    <!-- TAB LỊCH SỬ LƯƠNG -->
                    <!-- ====================================== -->

                    <TabItem Header="Lịch sử lương"/>

                    <!-- ====================================== -->
                    <!-- TAB PHỤ CẤP -->
                    <!-- ====================================== -->

                    <TabItem Header="Phụ cấp"/>

                </TabControl>

            </Grid>

        </GroupBox>

    </Grid>
</UserControl>
