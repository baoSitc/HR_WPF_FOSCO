<UserControl x:Class="HR_WPF_FOSCO.Views.HopDongDichVuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>

            <!-- SEARCH -->
            <RowDefinition Height="80"/>

            <!-- GRID -->
            <RowDefinition Height="250"/>

            <!-- FORM -->
            <RowDefinition Height="1.2*"/>

            <!-- PDF -->
            <RowDefinition Height="*"/>



        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- SEARCH -->
        <!-- ===================================================== -->

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <materialDesign:PackIcon Kind="Magnify"
                             Width="24"
                             Height="24"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"/>

                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                 x:Name="txtSearch" 
         Height="40"
         FontSize="14"
       
         materialDesign:HintAssist.Hint="Tìm kiếm hợp đồng..."
         TextChanged="txtSearch_TextChanged"/>
            </DockPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" 
             HorizontalAlignment="Right">

                <!-- THÊM -->

                <Button Width="120"
 Height="40"
 Margin="5"
 Click="BtnAdd_Click">

                    <Button.Content>

                        <StackPanel Orientation="Horizontal" >

                            <materialDesign:PackIcon Kind="Plus"
                              Width="18"
                              Height="18"
                              Margin="0,0,5,0"/>

                            <TextBlock Text="Thêm"/>

                        </StackPanel>

                    </Button.Content>

                </Button>
                <!-- SỬA -->

                <Button Width="120"
Height="40"
Margin="5"
Click="BtnUpdate_Click">

                    <Button.Content>

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Pencil"
                             Width="18"
                             Height="18"
                             Margin="0,0,5,0"/>

                            <TextBlock Text="Sửa"/>

                        </StackPanel>

                    </Button.Content>

                </Button>



                <!-- XÓA -->

                <Button Width="120"
             Height="40"
             Margin="5"
             Click="BtnDelete_Click">

                    <Button.Content>

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Delete"
                                          Width="18"
                                          Height="18"
                                          Margin="0,0,5,0"/>

                            <TextBlock Text="Xóa"/>

                        </StackPanel>

                    </Button.Content>

                </Button>

                <!-- LÀM MỚI -->

                <Button Width="120"
             Height="40"
             Margin="5"
             Click="BtnClear_Click">

                    <Button.Content>

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Refresh"
                                          Width="18"
                                          Height="18"
                                          Margin="0,0,5,0"/>

                            <TextBlock Text="Làm mới"/>

                        </StackPanel>

                    </Button.Content>

                </Button>

            </StackPanel>




        </Grid>

        <!-- GRID -->
        <GroupBox Grid.Row="1"
          Margin="5"
          FontWeight="SemiBold">

            <GroupBox.Header>

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="Table"
                                     Width="20"
                                     Height="20"
                                     Margin="0,0,5,0"/>

                    <TextBlock Text="Danh sách hợp đồng"/>

                </StackPanel>

            </GroupBox.Header>

            <Border Padding="10"
            Background="White"
            CornerRadius="5">

                <DataGrid x:Name="dgHopDong"
                Grid.Row="1"
                  Margin="0,10,0,10"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding HopDongDichVus}"
                  SelectedItem="{Binding SelectedHopDongDichVu, Mode=TwoWay}"
                          SelectionChanged="dgHopDong_SelectionChanged"

                  CanUserAddRows="False"
                  IsReadOnly="True"

                  SelectionMode="Single"

                      FrozenColumnCount="2"

                      EnableRowVirtualization="True"

                      EnableColumnVirtualization="True"

                      HeadersVisibility="Column"

                      GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>


                        <DataGridTextColumn Header="Số HĐ"
                                    Binding="{Binding SoHopDong}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Tên HĐ"
                                    Binding="{Binding TenHopDong}"
                                    Width="200"/>

                        <DataGridTextColumn Header="Đơn vị"
                                    Binding="{Binding DonVi.TenDonVi}"
                                    Width="250"/>

                        <DataGridTextColumn Header="Ngày ký"
                                    Binding="{Binding NgayKy,
                                    StringFormat=dd/MM/yyyy}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Từ ngày"
                                    Binding="{Binding TuNgay,
                                    StringFormat=dd/MM/yyyy}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Đến ngày"
                                    Binding="{Binding DenNgay,
                                    StringFormat=dd/MM/yyyy}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Loại lương"
                                    Binding="{Binding LoaiLuong}"
                                    Width="100"/>

                        <DataGridTextColumn Header="Loại phí"
                                    Binding="{Binding LoaiTinhPhi}"
                                    Width="100"/>

                        <DataGridTextColumn Header="Tỷ lệ phí"
                                    Binding="{Binding TyLePhi}"
                                    Width="100"/>

                        <DataGridTextColumn Header="Phí cố định"
                                    Binding="{Binding PhiCoDinh,
                                    StringFormat=N0}"
                                    Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>
            </Border>
        </GroupBox>

        <!-- FORM -->

        <GroupBox Grid.Row="2"
          Margin="5"
          FontWeight="SemiBold">

            <GroupBox.Header>

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="FileDocumentEdit"
                                     Width="20"
                                     Height="20"
                                     Margin="0,0,5,0"/>

                    <TextBlock Text="Thông tin hợp đồng"/>

                </StackPanel>

            </GroupBox.Header>

            <Border Padding="15"
            Background="White"
            CornerRadius="5">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="150"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="150"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="100"/>

                    </Grid.RowDefinitions>

                    <!-- ĐƠN VỊ -->

                    <TextBlock Text="Đơn vị:"
                           VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                          Height="30"

                          ItemsSource="{Binding DonVis}"

                          DisplayMemberPath="TenDonVi"

                          SelectedValuePath="ID_DonVi"

                          SelectedValue="{Binding SelectedHopDongDichVu.ID_DonVi,
                          Mode=TwoWay}"/>

                    <!-- SỐ HĐ -->

                    <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Số hợp đồng:"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <TextBox Grid.Row="0"
                         Grid.Column="3"
                         Height="30"
                         Text="{Binding SelectedHopDongDichVu.SoHopDong,
                         Mode=TwoWay}"/>

                    <!-- TÊN HĐ -->

                    <TextBlock Grid.Row="1"
                           Text="Tên hợp đồng:"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Height="30"
                         Text="{Binding SelectedHopDongDichVu.TenHopDong,
                         Mode=TwoWay}"/>

                    <!-- NGÀY KÝ -->

                    <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Ngày ký:"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <DatePicker Grid.Row="1"
                            Grid.Column="3"
                            SelectedDate="{Binding SelectedHopDongDichVu.NgayKy,
                            Mode=TwoWay}"/>

                    <!-- TỪ NGÀY -->

                    <TextBlock Grid.Row="2"
                           Text="Từ ngày:"
                           VerticalAlignment="Center"/>

                    <DatePicker Grid.Row="2"
                            Grid.Column="1"
                            SelectedDate="{Binding SelectedHopDongDichVu.TuNgay,
                            Mode=TwoWay}"/>

                    <!-- ĐẾN NGÀY -->

                    <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Đến ngày:"
                           VerticalAlignment="Center"/>

                    <DatePicker Grid.Row="2"
                            Grid.Column="3"
                            SelectedDate="{Binding SelectedHopDongDichVu.DenNgay,
                            Mode=TwoWay}"/>

                    <!-- LOẠI LƯƠNG -->

                    <TextBlock Grid.Row="3"
                           Text="Loại lương:"
                           VerticalAlignment="Center"/>

                    <ComboBox Grid.Row="3"
                          Grid.Column="1"
                          Height="30"
                          SelectedItem="{Binding SelectedHopDongDichVu.LoaiLuong}">

                        <ComboBoxItem Content="NET"/>

                        <ComboBoxItem Content="GROSS"/>

                    </ComboBox>

                    <!-- LOẠI PHÍ -->

                    <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Text="Loại phí:"
                           VerticalAlignment="Center"/>

                    <ComboBox Grid.Row="3"
                          Grid.Column="3"
                          Height="30"
                          SelectedItem="{Binding SelectedHopDongDichVu.LoaiTinhPhi}">

                        <ComboBoxItem Content="%"/>

                        <ComboBoxItem Content="FIX"/>

                    </ComboBox>

                    <!-- TỶ LỆ PHÍ -->

                    <TextBlock Grid.Row="4"
                           Text="Tỷ lệ phí:"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Height="30"
                         Text="{Binding SelectedHopDongDichVu.TyLePhi,
                         Mode=TwoWay}"/>

                    <!-- PHÍ CỐ ĐỊNH -->

                    <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           Text="Phí cố định:"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="4"
                         Grid.Column="3"
                         Height="30"
                         Text="{Binding SelectedHopDongDichVu.PhiCoDinh,
                         Mode=TwoWay}"/>

                    <!-- GHI CHÚ -->

                    <TextBlock Grid.Row="5"
                           Text="Ghi chú:"
                           VerticalAlignment="Top"/>

                    <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"

                         AcceptsReturn="True"

                         TextWrapping="Wrap"

                         VerticalScrollBarVisibility="Auto"

                         Text="{Binding SelectedHopDongDichVu.GhiChu,
                         Mode=TwoWay}"/>

                </Grid>

            </Border>
        </GroupBox>
        <!-- ===================================================== -->
        <!-- PDF -->
        <!-- ===================================================== -->

        <GroupBox Grid.Row="3" 
          Margin="5"
          FontWeight="SemiBold">

            <GroupBox.Header>

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="FilePdfBox"
                                     Width="20"
                                     Height="20"
                                     Margin="0,0,5,0"/>

                    <TextBlock Text="Tài liệu đính kèm"/>

                </StackPanel>

            </GroupBox.Header>

            <Border Padding="10"
            Background="White"
            CornerRadius="5">

                <Grid>
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="3*"/>

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <!-- TOOLBAR -->

                    <ComboBox x:Name="cbFiles" Grid.Row="0" 
                                  Style="{StaticResource MaterialDesignComboBox}"
                                    materialDesign:HintAssist.Hint="Danh sách tệp"
              Width="300"
              Height="35"
              Margin="5"
              DisplayMemberPath="TenFile"
                                  SelectionChanged="cbFiles_SelectionChanged"/>

                    <!-- ===================================================== -->
                    <!-- BUTTON -->
                    <!-- ===================================================== -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="5">

                        <Button Width="130" 
                            Height="35"
                            Margin="5"
                            Click="BtnUploadPDF_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="Upload"
                                 Width="18"
                                 Height="18"
                                 Margin="0,0,5,0"/>

                                <TextBlock Text="Upload"/>

                            </StackPanel>

                        </Button>



                        <!-- Download -->
                        <Button Width="130" 
           Height="35"
           Margin="5"
           Click="BtnDownloadFile_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="Download"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,5,0"/>

                                <TextBlock Text="Download"/>

                            </StackPanel>
                        </Button>
                        <!-- Delete -->
                        <Button Width="130" 
           Height="35"
           Margin="5"
           Click="BtnDeleteFile_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="Delete"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,5,0"/>

                                <TextBlock Text="Delete file"/>

                            </StackPanel>
                        </Button>
                    </WrapPanel>




                    <!-- PDF VIEW -->

                    <WebBrowser x:Name="PdfViewer"
                            Grid.Column="1" Grid.RowSpan="2"/>


                </Grid>
            </Border>
        </GroupBox>






    </Grid>

</UserControl>